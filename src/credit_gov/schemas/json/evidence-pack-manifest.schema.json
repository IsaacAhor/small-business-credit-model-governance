{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/evidence-pack-manifest.schema.json",
  "title": "Evidence Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "run_id",
    "created_at",
    "model_id",
    "version_id",
    "input_references",
    "output_files",
    "reviewer_status"
  ],
  "properties": {
    "record_type": {
      "const": "evidence_pack_manifest"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[a-z0-9-]+$"
    },
    "created_at": {
      "type": "string",
      "minLength": 10
    },
    "model_id": {
      "type": "string",
      "pattern": "^mdl-[a-z0-9-]+$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^ver-[a-z0-9-]+$"
    },
    "input_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "output_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "reviewer_status": {
      "enum": [
        "pending_review",
        "reviewed",
        "escalated"
      ]
    }
  }
}
