{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/outcome-record.schema.json",
  "title": "Outcome Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "outcome_id",
    "decision_id",
    "observation_period",
    "repayment_or_default_indicator",
    "realized_outcome_value"
  ],
  "properties": {
    "record_type": {
      "const": "outcome_record"
    },
    "outcome_id": {
      "type": "string",
      "pattern": "^out-[a-z0-9-]+$"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^dec-[a-z0-9-]+$"
    },
    "observation_period": {
      "type": "string",
      "pattern": "^[0-9]+m$"
    },
    "repayment_or_default_indicator": {
      "enum": [
        "performing",
        "delinquent",
        "default"
      ]
    },
    "realized_outcome_value": {
      "type": "number"
    }
  }
}
