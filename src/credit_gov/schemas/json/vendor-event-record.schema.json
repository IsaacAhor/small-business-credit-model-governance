{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vendor-event-record.schema.json",
  "title": "Vendor Event Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "event_id",
    "review_id",
    "component_id",
    "event_type",
    "detected_at",
    "materiality",
    "affected_version",
    "impact_summary",
    "contract_notice_status",
    "institution_assessment_required",
    "assessment_disposition",
    "escalation_owner",
    "remediation_status",
    "evidence_references",
    "result_type"
  ],
  "properties": {
    "record_type": {"const": "vendor_event_record"},
    "event_id": {"type": "string", "pattern": "^vme-[a-z0-9-]+$"},
    "review_id": {"type": "string", "pattern": "^vrr-[a-z0-9-]+$"},
    "component_id": {"type": "string", "pattern": "^vmc-[a-z0-9-]+$"},
    "event_type": {"enum": ["model_change", "data_change", "subprocessor_change", "threshold_change", "reason_mapping_change", "service_change", "security_event"]},
    "detected_at": {"type": "string", "format": "date-time"},
    "vendor_notice_at": {"type": "string", "format": "date-time"},
    "materiality": {"enum": ["non_material", "material", "high", "critical"]},
    "affected_version": {"type": "string", "minLength": 3},
    "impact_summary": {"type": "string", "minLength": 15},
    "contract_notice_status": {"enum": ["not_required", "timely", "late", "not_received", "pending_review"]},
    "institution_assessment_required": {"type": "boolean"},
    "assessment_disposition": {"enum": ["pending", "accepted_with_controls", "remediated", "no_action", "reliance_suspended", "rejected"]},
    "escalation_owner": {"type": "string", "minLength": 3},
    "remediation_status": {"enum": ["not_required", "open", "in_progress", "remediated", "closed"]},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "result_type": {"const": "vendor_event_fact_record_not_reportability_determination"}
  }
}
