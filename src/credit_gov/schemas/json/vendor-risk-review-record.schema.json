{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vendor-risk-review-record.schema.json",
  "title": "Vendor Risk Review Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "review_id",
    "vendor_id",
    "product_id",
    "product_version",
    "review_period_start",
    "review_period_end",
    "covered_use_cases",
    "decision_impact",
    "decision_authority",
    "model_id",
    "version_id",
    "applicability_determinations",
    "document_versions",
    "contract_version",
    "risk_tier",
    "risk_rationale",
    "evidence_references",
    "owners",
    "findings",
    "review_status",
    "signoff",
    "result_type"
  ],
  "properties": {
    "record_type": {"const": "vendor_risk_review_record"},
    "review_id": {"type": "string", "pattern": "^vrr-[a-z0-9-]+$"},
    "vendor_id": {"type": "string", "pattern": "^vnd-[a-z0-9-]+$"},
    "product_id": {"type": "string", "pattern": "^prd-[a-z0-9-]+$"},
    "product_version": {"type": "string", "minLength": 3},
    "review_period_start": {"type": "string", "format": "date"},
    "review_period_end": {"type": "string", "format": "date"},
    "covered_use_cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "application_intake",
          "scoring",
          "pricing",
          "routing",
          "approval_recommendation",
          "underwriting_decision_support",
          "adverse_action_reason_support",
          "manual_review",
          "override_support",
          "ongoing_monitoring"
        ]
      }
    },
    "decision_impact": {
      "enum": ["binding_decision", "recommendation", "decision_input", "explanation_support", "monitoring_only"]
    },
    "decision_authority": {
      "enum": ["institution", "shared", "vendor", "not_determined"]
    },
    "model_id": {"type": "string", "pattern": "^mdl-[a-z0-9-]+$"},
    "version_id": {"type": "string", "pattern": "^ver-[a-z0-9-]+$"},
    "applicability_determinations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_class", "applicability", "determination", "evidence_reference", "checked_on"],
        "properties": {
          "source_id": {"type": "string", "minLength": 3},
          "source_class": {"enum": ["binding_when_applicable", "supervisory_guidance", "voluntary_or_analogous", "institution_policy_or_contract"]},
          "applicability": {"enum": ["applicable", "not_applicable", "pending_determination"]},
          "determination": {"type": "string", "minLength": 15},
          "evidence_reference": {"type": "string", "minLength": 3},
          "checked_on": {"type": "string", "format": "date"}
        }
      }
    },
    "document_versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_name", "document_version", "evidence_reference"],
        "properties": {
          "document_name": {"type": "string", "minLength": 3},
          "document_version": {"type": "string", "minLength": 1},
          "evidence_reference": {"type": "string", "minLength": 3}
        }
      }
    },
    "contract_version": {"type": "string", "minLength": 3},
    "risk_tier": {"enum": ["low", "moderate", "high", "critical"]},
    "risk_rationale": {"type": "string", "minLength": 20},
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3}
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_owner", "vendor_management_owner", "model_risk_owner", "compliance_owner"],
      "properties": {
        "business_owner": {"type": "string", "minLength": 3},
        "vendor_management_owner": {"type": "string", "minLength": 3},
        "model_risk_owner": {"type": "string", "minLength": 3},
        "compliance_owner": {"type": "string", "minLength": 3}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "severity", "summary", "status", "owner", "target_date"],
        "properties": {
          "finding_id": {"type": "string", "pattern": "^vrf-[a-z0-9-]+$"},
          "severity": {"enum": ["low", "moderate", "high", "critical"]},
          "summary": {"type": "string", "minLength": 10},
          "status": {"enum": ["open", "accepted", "remediated", "closed"]},
          "owner": {"type": "string", "minLength": 3},
          "target_date": {"type": "string", "format": "date"}
        }
      }
    },
    "review_status": {"enum": ["draft", "pending_review", "accepted_with_conditions", "accepted", "rejected"]},
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_identity", "reviewer_role", "independence_status", "disposition", "review_date"],
      "properties": {
        "reviewer_identity": {"type": "string", "minLength": 3},
        "reviewer_role": {"type": "string", "minLength": 3},
        "independence_status": {"enum": ["developer_self_review", "independent_internal", "independent_external", "pending_assignment"]},
        "disposition": {"enum": ["pending", "accepted_with_conditions", "accepted", "rejected"]},
        "review_date": {"type": "string", "format": "date"}
      }
    },
    "result_type": {"const": "vendor_oversight_record_not_compliance_or_regulatory_approval"}
  }
}
