{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vendor-oversight-config.schema.json",
  "title": "Vendor Oversight Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "oversight_config_id",
    "review_id",
    "risk_tier",
    "review_cadence",
    "cadence_rationale",
    "metric_threshold_references",
    "event_triggers",
    "heightened_monitoring",
    "owners",
    "reporting_audience",
    "result_type"
  ],
  "properties": {
    "record_type": {"const": "vendor_oversight_config"},
    "oversight_config_id": {"type": "string", "pattern": "^voc-[a-z0-9-]+$"},
    "review_id": {"type": "string", "pattern": "^vrr-[a-z0-9-]+$"},
    "risk_tier": {"enum": ["low", "moderate", "high", "critical"]},
    "review_cadence": {"type": "string", "minLength": 5},
    "cadence_rationale": {"type": "string", "minLength": 20},
    "metric_threshold_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "event_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["model_change", "data_change", "subprocessor_change", "threshold_change", "reason_mapping_change", "service_change", "security_event", "performance_breach", "reason_qa_failure"]}
    },
    "heightened_monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status", "entry_criteria", "exit_criteria", "evidence_due_date"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "configured", "active", "pending_evidence", "complete"]},
        "entry_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "exit_criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 5}},
        "evidence_due_date": {"type": "string", "format": "date"}
      }
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["monitoring_owner", "escalation_owner", "reporting_owner"],
      "properties": {
        "monitoring_owner": {"type": "string", "minLength": 3},
        "escalation_owner": {"type": "string", "minLength": 3},
        "reporting_owner": {"type": "string", "minLength": 3}
      }
    },
    "reporting_audience": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "result_type": {"const": "risk_based_vendor_monitoring_config_not_regulatory_schedule"}
  }
}
