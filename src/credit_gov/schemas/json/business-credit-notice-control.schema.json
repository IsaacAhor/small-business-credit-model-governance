{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/business-credit-notice-control.schema.json",
  "title": "Business Credit Notice Control",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "notice_control_id",
    "review_id",
    "component_id",
    "decision_id",
    "credit_classification",
    "path_determination",
    "application_date",
    "action_date",
    "reason_source_references",
    "reason_mapping_ids",
    "specific_reason_review",
    "retention_basis",
    "fcra_applicability",
    "esign_applicability",
    "section_1071_applicability",
    "reviewer_disposition",
    "evidence_references",
    "result_type"
  ],
  "properties": {
    "record_type": {"const": "business_credit_notice_control"},
    "notice_control_id": {"type": "string", "pattern": "^bcn-[a-z0-9-]+$"},
    "review_id": {"type": "string", "pattern": "^vrr-[a-z0-9-]+$"},
    "component_id": {"type": "string", "pattern": "^vmc-[a-z0-9-]+$"},
    "decision_id": {"type": "string", "minLength": 3},
    "credit_classification": {"enum": ["business_revenue_at_or_below_1m", "business_revenue_above_1m", "startup_business", "pending_determination"]},
    "path_determination": {"enum": ["written_notice_with_reasons", "written_notice_with_right_to_reasons", "oral_or_written_notice_subject_to_request", "pending_legal_review"]},
    "application_date": {"type": "string", "format": "date"},
    "action_date": {"type": "string", "format": "date"},
    "reason_source_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "reason_mapping_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "specific_reason_review": {"enum": ["pending", "completed", "gap_identified", "not_applicable"]},
    "retention_basis": {"type": "string", "minLength": 15},
    "fcra_applicability": {"enum": ["applicable", "not_applicable", "pending_determination"]},
    "esign_applicability": {"enum": ["applicable", "not_applicable", "pending_determination"]},
    "section_1071_applicability": {"enum": ["applicable", "not_applicable", "pending_determination"]},
    "reviewer_disposition": {"enum": ["pending", "accepted_with_conditions", "accepted", "rejected"]},
    "evidence_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "result_type": {"const": "business_credit_notice_control_not_legal_sufficiency_finding"}
  }
}
