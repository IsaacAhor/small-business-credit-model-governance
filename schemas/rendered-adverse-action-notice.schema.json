{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/rendered-adverse-action-notice.schema.json",
  "title": "Rendered Adverse-Action Notice",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "notice_id",
    "decision_id",
    "notice_template_id",
    "notice_template_version",
    "rendered_reason_segments"
  ],
  "properties": {
    "record_type": {"const": "rendered_adverse_action_notice"},
    "notice_id": {"type": "string", "pattern": "^aan-[a-z0-9-]+$"},
    "decision_id": {"type": "string", "pattern": "^dec-[0-9]{4}$"},
    "notice_template_id": {"type": "string", "minLength": 3},
    "notice_template_version": {"type": "string", "minLength": 3},
    "rendered_reason_segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason_output_id", "reason_code", "rendered_reason_text"],
        "properties": {
          "reason_output_id": {"type": "string", "pattern": "^rso-[a-z0-9-]+$"},
          "reason_code": {"type": "string", "pattern": "^RC-[0-9]{3}$"},
          "rendered_reason_text": {"type": "string", "minLength": 5}
        }
      }
    }
  }
}
