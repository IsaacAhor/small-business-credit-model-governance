{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/vendor-model-component.schema.json",
  "title": "Vendor Model Component",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "component_id",
    "review_id",
    "component_type",
    "function",
    "model_reference_status",
    "model_id",
    "version_id",
    "data_categories",
    "output_type",
    "decision_role",
    "model_change_notice_method",
    "subcontractor_status",
    "transparency_state",
    "limitation_ids",
    "event_status",
    "event_ids",
    "result_type"
  ],
  "properties": {
    "record_type": {"const": "vendor_model_component"},
    "component_id": {"type": "string", "pattern": "^vmc-[a-z0-9-]+$"},
    "review_id": {"type": "string", "pattern": "^vrr-[a-z0-9-]+$"},
    "component_type": {"enum": ["model", "rules_engine", "score_service", "explanation_service", "data_service", "other"]},
    "function": {"type": "string", "minLength": 10},
    "model_reference_status": {"enum": ["known", "not_available", "not_applicable"]},
    "model_id": {"type": "string", "minLength": 3},
    "version_id": {"type": "string", "minLength": 3},
    "data_categories": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
    "output_type": {"enum": ["score", "rank", "recommendation", "decision", "reason", "monitoring_signal", "other"]},
    "decision_role": {"enum": ["binding", "advisory", "input", "explanation_only", "monitoring_only"]},
    "model_change_notice_method": {"type": "string", "minLength": 10},
    "subcontractor_status": {"enum": ["none_disclosed", "disclosed", "unknown"]},
    "transparency_state": {"enum": ["transparent", "partial", "opaque"]},
    "limitation_ids": {"type": "array", "items": {"type": "string", "pattern": "^vml-[a-z0-9-]+$"}},
    "event_status": {"enum": ["no_event_reported", "event_reported", "pending_determination"]},
    "event_ids": {"type": "array", "items": {"type": "string", "pattern": "^vme-[a-z0-9-]+$"}},
    "result_type": {"const": "vendor_component_inventory_not_safety_or_reliability_finding"}
  }
}
