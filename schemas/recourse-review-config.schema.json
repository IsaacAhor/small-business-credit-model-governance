{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/recourse-review-config.schema.json",
  "title": "Recourse Review Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "recourse_run_id",
    "assessment_date",
    "model_id",
    "version_id",
    "recourse_method_id",
    "method_version",
    "action_set_id",
    "action_set_version",
    "recourse_subject_ids",
    "target_prediction",
    "eligible_baseline_outcome",
    "maximum_joint_action_size",
    "maximum_evaluated_states",
    "fixed_finding_rule",
    "withholding_rules",
    "audience",
    "output_directory_policy",
    "result_type"
  ],
  "properties": {
    "record_type": {"const": "recourse_review_config"},
    "recourse_run_id": {"type": "string", "pattern": "^rcrun-[a-z0-9-]+$"},
    "assessment_date": {"type": "string", "format": "date"},
    "model_id": {"type": "string", "pattern": "^mdl-[a-z0-9-]+$"},
    "version_id": {"type": "string", "pattern": "^ver-[a-z0-9-]+$"},
    "recourse_method_id": {"type": "string", "pattern": "^rcm-[a-z0-9-]+$"},
    "method_version": {"type": "string", "pattern": "^rcmver-[a-z0-9-]+$"},
    "action_set_id": {"type": "string", "pattern": "^ras-[a-z0-9-]+$"},
    "action_set_version": {"type": "string", "pattern": "^rasver-[a-z0-9-]+$"},
    "recourse_subject_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^rcs-[a-z0-9-]+$"}
    },
    "target_prediction": {"type": "string", "minLength": 3},
    "eligible_baseline_outcome": {"type": "string", "minLength": 3},
    "maximum_joint_action_size": {"type": "integer", "minimum": 1},
    "maximum_evaluated_states": {"type": "integer", "minimum": 1},
    "sample_count": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer", "minimum": 0},
    "fixed_finding_rule": {"enum": ["exhaustive_enumeration_only", "documented_certificate_required"]},
    "withholding_rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10}
    },
    "audience": {"const": "reviewer_only"},
    "output_directory_policy": {"const": "separate_from_all_input_trees"},
    "result_type": {"const": "configured_recourse_review_not_applicant_advice"}
  }
}
