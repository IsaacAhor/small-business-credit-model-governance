{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/model-monitoring-plan.schema.json",
  "title": "Model Monitoring Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "monitoring_plan_id",
    "model_id",
    "version_id",
    "risk_profile_id",
    "validation_id",
    "threshold_set_id",
    "plan_version",
    "effective_date",
    "review_cadence",
    "explainability_method_ids",
    "metrics",
    "limitation_review_items",
    "change_triggers",
    "reason_monitoring_scope",
    "escalation_owner",
    "review_owner",
    "status",
    "result_type"
  ],
  "properties": {
    "record_type": {
      "const": "model_monitoring_plan"
    },
    "monitoring_plan_id": {
      "type": "string",
      "pattern": "^mnp-[a-z0-9-]+$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^mdl-[a-z0-9-]+$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^ver-[a-z0-9-]+$"
    },
    "risk_profile_id": {
      "type": "string",
      "pattern": "^mrp-[a-z0-9-]+$"
    },
    "validation_id": {
      "type": "string",
      "pattern": "^val-[a-z0-9-]+$"
    },
    "threshold_set_id": {
      "type": "string",
      "minLength": 3
    },
    "plan_version": {
      "type": "string",
      "minLength": 3
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "review_cadence": {
      "type": "string",
      "minLength": 3
    },
    "explainability_method_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^xai-[a-z0-9-]+$"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric_name",
          "purpose",
          "evidence_source",
          "threshold_reference",
          "action_on_breach"
        ],
        "properties": {
          "metric_name": {
            "type": "string",
            "minLength": 3
          },
          "purpose": {
            "type": "string",
            "minLength": 10
          },
          "evidence_source": {
            "type": "string",
            "minLength": 3
          },
          "threshold_reference": {
            "type": "string",
            "minLength": 3
          },
          "action_on_breach": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "limitation_review_items": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "change_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "reason_monitoring_scope": {
      "type": "string",
      "minLength": 10
    },
    "escalation_owner": {
      "type": "string",
      "minLength": 3
    },
    "review_owner": {
      "type": "string",
      "minLength": 3
    },
    "status": {
      "enum": ["draft", "active", "suspended", "retired"]
    },
    "result_type": {
      "const": "risk_based_monitoring_plan_not_regulatory_schedule"
    }
  }
}
