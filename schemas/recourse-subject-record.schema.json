{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/recourse-subject-record.schema.json",
  "title": "Recourse Subject Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "recourse_subject_id",
    "decision_id",
    "model_id",
    "version_id",
    "feature_schema_version",
    "feature_values",
    "source_class",
    "provenance_note",
    "assessment_scope",
    "result_type"
  ],
  "properties": {
    "record_type": {"const": "recourse_subject_record"},
    "recourse_subject_id": {"type": "string", "pattern": "^rcs-[a-z0-9-]+$"},
    "decision_id": {"type": "string", "pattern": "^dec-[a-z0-9-]+$"},
    "model_id": {"type": "string", "pattern": "^mdl-[a-z0-9-]+$"},
    "version_id": {"type": "string", "pattern": "^ver-[a-z0-9-]+$"},
    "feature_schema_version": {"type": "string", "pattern": "^featver-[a-z0-9-]+$"},
    "feature_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_name", "value"],
        "properties": {
          "feature_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "value": {"type": "number"}
        }
      }
    },
    "source_class": {
      "enum": ["synthetic", "deidentified_private", "permissioned_controlled"]
    },
    "provenance_note": {"type": "string", "minLength": 15},
    "assessment_scope": {"enum": ["eligible", "excluded"]},
    "exclusion_reason": {"type": "string", "minLength": 10},
    "result_type": {"const": "recourse_input_not_applicant_instruction"}
  }
}
