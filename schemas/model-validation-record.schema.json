{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/model-validation-record.schema.json",
  "title": "Model Validation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_type",
    "validation_id",
    "model_id",
    "version_id",
    "validation_date",
    "validation_scope",
    "validator_role",
    "independence_status",
    "reviewer_identity",
    "evidence_references",
    "explainability_method_ids",
    "findings",
    "limitations",
    "overall_disposition",
    "promotion_allowed",
    "result_type"
  ],
  "properties": {
    "record_type": {
      "const": "model_validation_record"
    },
    "validation_id": {
      "type": "string",
      "pattern": "^val-[a-z0-9-]+$"
    },
    "model_id": {
      "type": "string",
      "pattern": "^mdl-[a-z0-9-]+$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^ver-[a-z0-9-]+$"
    },
    "validation_date": {
      "type": "string",
      "format": "date"
    },
    "validation_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "conceptual_soundness",
          "developmental_testing",
          "outcome_analysis",
          "implementation_verification",
          "explainability_method",
          "ongoing_monitoring",
          "change_review"
        ]
      }
    },
    "validator_role": {
      "type": "string",
      "minLength": 3
    },
    "independence_status": {
      "enum": [
        "developer_self_review",
        "independent_internal",
        "independent_external",
        "pending_assignment"
      ]
    },
    "reviewer_identity": {
      "type": "string",
      "minLength": 3
    },
    "evidence_references": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "explainability_method_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^xai-[a-z0-9-]+$"
      }
    },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "severity",
          "summary",
          "status",
          "owner",
          "target_date"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^vf-[a-z0-9-]+$"
          },
          "severity": {
            "enum": ["low", "moderate", "high", "critical"]
          },
          "summary": {
            "type": "string",
            "minLength": 10
          },
          "status": {
            "enum": ["open", "accepted", "remediated", "closed"]
          },
          "owner": {
            "type": "string",
            "minLength": 3
          },
          "target_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "overall_disposition": {
      "enum": [
        "pending_independent_review",
        "approved_with_conditions",
        "approved",
        "rejected"
      ]
    },
    "promotion_allowed": {
      "type": "boolean"
    },
    "result_type": {
      "const": "validation_governance_record_not_compliance_or_approval_claim"
    }
  }
}
